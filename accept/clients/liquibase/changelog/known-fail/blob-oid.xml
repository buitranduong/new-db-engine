<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!-- Liquibase maps BLOB to OID on PostgreSQL. Run alone: lb.sh <t> --changelog-file=known-fail/blob-oid.xml update -->
    <changeSet id="kf-blob-1" author="app">
        <createTable tableName="KF_BLOB"><column name="ID" type="INT"/><column name="DATA" type="BLOB"/></createTable>
    </changeSet>
</databaseChangeLog>
